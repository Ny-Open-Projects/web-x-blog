# ---- 服务 ----
SERVER_PORT=3000

# ---- 数据库（主库，含 wf_* 表）----
DB_HOST=mysql
DB_PORT=3306
DB_USER=lowcode
DB_PASSWORD=change_me
DB_DATABASE=lowcode

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- OSS（商业化前必配；密钥仅服务端，绝不进前端 / 图 JSON / 沙箱）----
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- 限流 / 计量（商业化钩子预留）----
RATE_LIMIT_PER_TENANT=1000

# ---- 沙箱（脚本 / LLM 节点）----
SANDBOX_ENABLED=true
WF_SANDBOX_TIMEOUT_MS=2000
WF_SANDBOX_MAX_OUTPUT_BYTES=262144

# ---- M8 隔离层 ----
# vm      = 软隔离（vm + 超时 + 配额 + 审计），自托管单租户够用，零依赖。
# container = 容器硬隔离（一次性容器 + CapDrop ALL + 禁网 + 只读根 + 内存/CPU/PID 限额），
#            多租户 / 对外开放脚本编辑必选；Docker 不可用时自动回退 vm 并在审计中标注。
WF_SANDBOX_MODE=vm
# 运行时镜像：默认用官方 node:20-alpine；国内拉不动时用本地构建的 lowcode-node-sandbox:20
# （构建脚本见 apps/server/Dockerfile.sandbox，README 有说明）
WF_SANDBOX_IMAGE=node:20-alpine
WF_SANDBOX_MEMORY_BYTES=134217728
WF_SANDBOX_NANO_CPUS=500000000
WF_SANDBOX_PIDS_LIMIT=64
# Docker socket：Linux/macOS 默认 /var/run/docker.sock，Windows 默认 //./pipe/docker_engine
# WF_DOCKER_SOCKET=/var/run/docker.sock

# ---- 大模型（ai.llm 节点；密钥仅服务端，绝不下发前端 / 不进图 JSON）----
# 留空走内置 mock（不连外部服务即可跑通链路）。
# 填了 LLM_BASE_URL + LLM_API_KEY 即走 OpenAI 兼容网关（通义/DeepSeek/本地 Ollama 等）。
# 例：base=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
