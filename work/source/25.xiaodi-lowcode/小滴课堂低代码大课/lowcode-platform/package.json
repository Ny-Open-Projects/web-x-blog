{
  "name": "lowcode-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.7",
  "engines": { "node": ">=18" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build -w @lowcode/shared && npm run build -w @lowcode/server && npm run build -w @lowcode/studio",
    "dev": "npm run dev --workspaces --parallel",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
