# ============================================================
# 编辑器前端环境变量模板 —— 复制为 .env.local 并填写
# (packages/client/.env.local,Vite 约定)
# ============================================================

# 后端 API 地址(Nginx 网关入口,结尾不带 /)
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# 发布页(C 端 Next.js)访问地址,结尾不带 /
VITE_RELEASE_BASE_URL=http://127.0.0.1:4000
