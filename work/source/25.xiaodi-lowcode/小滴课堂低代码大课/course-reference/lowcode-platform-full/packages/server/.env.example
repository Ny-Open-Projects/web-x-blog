# ============================================================
# 后端环境变量模板 —— 复制为 .env 并填写(packages/server/.env)
# 生产环境由 Docker/CI 注入,绝不把真实值提交到仓库
# ============================================================

# ---- MySQL(必填)----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=你的数据库密码
DB_DATABASE=xdclass-lowcode
# 开发期允许 TypeORM 自动同步表结构;生产务必保持 false(用 migration)
DB_SYNCHRONIZE=true

# ---- Redis(必填)----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=你的Redis密码

# ---- JWT(必填,生产用强随机串)----
# 生成示例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请替换为至少32位的强随机串
JWT_EXPIRES_IN=7d

# ---- 短信服务(选填,不填则短信功能不可用)----
SMS_APPID=
SMS_APP_SECRET=
SMS_API=https://api-v2.xdclass.net/send_sms

# ---- 微信扫码登录(选填)----
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=

# ---- 阿里云 OSS(选填,不填则资源上传不可用)----
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_DOMAIN=https://你的自定义域名
