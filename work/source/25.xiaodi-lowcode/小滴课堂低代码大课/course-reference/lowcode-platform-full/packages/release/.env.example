# ============================================================
# 发布页(Next.js)环境变量模板 —— 复制为 .env.local 并填写
# (packages/release/.env.local)
# NEXT_PUBLIC_ 前缀变量会同时注入服务端与浏览器端
# ============================================================

# 后端 API 地址(Nginx 网关入口,结尾不带 /api)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api
